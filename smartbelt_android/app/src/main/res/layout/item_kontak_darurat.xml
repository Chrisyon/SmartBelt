<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/stroke_card"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Badges: Prioritas & Hubungan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPrioritasBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_dynamic_island"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="PRIORITAS 1 (UTAMA)"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHubunganBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#F1F5F9"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="KELUARGA"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Contact Name & Phone -->
        <TextView
            android:id="@+id/tvNamaKontak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-black"
            android:text="Budi Sudirman"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_call"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvNoTelepon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="081234567890"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/divider" />

        <!-- Bottom Action Buttons: Call, Edit, Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Panggil"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="#10B981"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_call"
                app:iconSize="16dp"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="Edit"
                android:textColor="#2563EB"
                android:textSize="12sp"
                app:backgroundTint="#EFF6FF"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_edit"
                app:iconSize="16dp"
                app:iconTint="#2563EB"
                app:strokeColor="#BFDBFE"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:padding="0dp"
                app:backgroundTint="#FEF2F2"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="#DC2626"
                app:strokeColor="#FECACA"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
