<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/stroke_card"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Apple Squircle Avatar -->
            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ios_icon_squircle"
                android:padding="10dp"
                android:src="@drawable/ic_person"
                app:tint="#2563EB" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:layout_toStartOf="@id/tvStatusBadge"
                android:layout_toEndOf="@id/ivAvatar"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNamaPenghuni"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Bapak Yohannes Sitompul"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvKamar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kamar A-01 • Laki-laki"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_online"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="AKTIF"
                android:textColor="#16A34A"
                android:textSize="11sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Riwayat Medis -->
        <TextView
            android:id="@+id/tvRiwayatPenyakit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/bg_app"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Riwayat: Riwayat stroke ringan, hipertensi"
            android:textColor="#475569"
            android:textSize="12sp" />

        <!-- Footer: Smart-Belt Status & Edit Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDeviceBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📟 Sabuk: Smart-Belt #01"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditPenghuni"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Kelola / Edit"
                android:textAllCaps="false"
                android:textColor="#2563EB"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="#93C5FD" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
