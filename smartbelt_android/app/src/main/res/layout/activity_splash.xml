<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Center Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- Floating Apple Squircle Icon Emblem -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:cardBackgroundColor="#131C31"
            app:cardCornerRadius="28dp"
            app:cardElevation="12dp"
            app:strokeColor="#2563EB"
            app:strokeWidth="1.8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="22dp"
                android:src="@drawable/ic_shield"
                app:tint="#60A5FA" />
        </com.google.android.material.card.MaterialCardView>

        <!-- App Brand Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:text="SMART-BELT"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <!-- Subtitle Tracking -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.08"
            android:text="INTELLIGENT FALL DETECTION &amp; MONITORING"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Location Pill Capsule -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_ios_dynamic_island"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Wisma Panti Lansia INAKAKA • Ambon"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Apple Minimalist Progress Spinner -->
        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="44dp"
            android:indeterminateTint="#38BDF8" />

    </LinearLayout>

    <!-- Footer Credit in Subtle Pill Capsule -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.03"
            android:text="TUGAS AKHIR"
            android:textColor="#475569"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chrisyon Putra Sitania (160422121)"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>
