<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#180505"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <!-- Top Back Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackEmergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:backgroundTint="#3B0D0D"
                android:fontFamily="sans-serif-bold"
                android:text="Tutup Sementara"
                android:textColor="#FCA5A5"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="14dp"
                app:iconTint="#FCA5A5"
                app:strokeColor="#7F1D1D"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:fontFamily="sans-serif-medium"
                android:text="🚨 Alarm Aktif"
                android:textColor="#EF4444"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Two Column Content Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- LEFT COLUMN: Countdown & Cancel Alarm -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="PERINGATAN DARURAT!"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvAlertType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_ios_dynamic_island"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="BENTURAN JATUH TERDETEKSI"
                    android:textColor="#FCA5A5"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Countdown Box -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#2A0B0B"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#7F1D1D"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:id="@+id/tvCountdownLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:fontFamily="sans-serif-medium"
                            android:text="Panggilan &amp; SMS Darurat Otomatis dalam:"
                            android:textColor="#FCA5A5"
                            android:textSize="11sp" />

                        <!-- Apple Watch Style Countdown Circle Widget -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            app:cardBackgroundColor="#450A0A"
                            app:cardCornerRadius="36dp"
                            app:cardElevation="4dp"
                            app:strokeColor="#EF4444"
                            app:strokeWidth="2dp">

                            <TextView
                                android:id="@+id/tvCountdown"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:fontFamily="sans-serif-black"
                                android:text="10"
                                android:textColor="@color/white"
                                android:textSize="36sp" />
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Primary Action: Batalkan Alarm -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.03"
                    android:text="BATALKAN ALARM"
                    android:textColor="#DC2626"
                    android:textSize="13sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="14dp"
                    app:elevation="4dp"
                    app:icon="@drawable/ic_check_circle"
                    app:iconGravity="textStart"
                    app:iconTint="#DC2626" />

            </LinearLayout>

            <!-- RIGHT COLUMN: Resident Info, Call Sequence, Other Actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <!-- Resident Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#2A0B0B"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#7F1D1D"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvResidentNameAlert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Bapak Yohannes Sitompul"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvLocationAlert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Kamar A-01 • Wisma INAKAKA Ambon"
                            android:textColor="#FCA5A5"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvSvmImpact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_ios_dynamic_island"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Kekuatan Benturan: SVM 3.45g"
                            android:textColor="#FECACA"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Call Sequence Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCallSequence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#2A0B0B"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#7F1D1D"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_call"
                                app:tint="#34D399" />

                            <TextView
                                android:id="@+id/tvCallTargetTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-black"
                                android:text="Panggilan Darurat Berurutan"
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvCallCycleStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_ios_dynamic_island"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="Auto Loop"
                                android:textColor="#34D399"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCurrentCallingContact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Memanggil Prioritas #1: Budi Sudirman..."
                            android:textColor="#FCA5A5"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDialCurrent"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="40dp"
                                android:layout_weight="1"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="4dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="Panggil Sekarang"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                app:backgroundTint="#10B981"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/ic_call"
                                app:iconSize="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNextContact"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="40dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="4dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="Berikutnya ⏭"
                                android:textColor="#FCA5A5"
                                android:textSize="10sp"
                                app:backgroundTint="#3B0D0D"
                                app:cornerRadius="8dp"
                                app:strokeColor="#7F1D1D"
                                app:strokeWidth="1dp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Two Secondary Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Call Caregiver Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCallCaregiver"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="TELEPON"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_call"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white"
                        app:strokeColor="#7F1D1D"
                        app:strokeWidth="1.5dp" />

                    <!-- View Map Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewMap"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="LIHAT PETA"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_map"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white"
                        app:strokeColor="#7F1D1D"
                        app:strokeWidth="1.5dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
